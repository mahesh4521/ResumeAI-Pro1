# ===== ResumeAI Pro - Environment Variables =====

# Database URL
# For local development with MySQL:
# DATABASE_URL=mysql+pymysql://root:passw0rd@localhost/ai_analyser
# For production with SQLite (simple, no extra setup):
DATABASE_URL=sqlite:///./resumeai.db

# AI Provider: Google Gemini API Key
# Get your free key from: https://aistudio.google.com/
# If not set, the app will try to use local Ollama instead.
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Allowed Origins (comma-separated, only needed if frontend is on a different domain)
# ALLOWED_ORIGINS=https://your-frontend.onrender.com,http://localhost:3006

# Server port (Render sets this automatically)
# PORT=8006
